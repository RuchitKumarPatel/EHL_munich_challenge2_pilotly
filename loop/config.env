# Overnight loop configuration. Sourced by loop/run.sh. Edit before starting.

# --- identity -----------------------------------------------------------------
# Used to fill the deck's title slide. If TEAM_MEMBERS is left empty the deck keeps
# a visible [FILL] marker there rather than inventing names.
TEAM_NAME="Pilotly"
TEAM_MEMBERS=""

# --- stopping conditions (whichever hits first wins) ---------------------------
LOOP_HOURS=8                  # wall clock budget from start
LOOP_MAX_TURNS=40

# This account authenticates with an OAuth subscription (Claude Max 20x), not an API
# key, and extra usage is disabled. So the loop spends RATE-LIMIT QUOTA, not money:
# `total_cost_usd` in each turn's JSON is a notional API-equivalent figure that is
# never billed. It is still the best available proxy for how much quota a turn ate,
# which is why it stays as a ceiling -- but read it as "effort spent", not "dollars".
LOOP_BUDGET_USD=400

# The guard that actually protects you. The 7-day window is shared with everything
# else you do this week, including the presentation day itself. The loop stops once
# the rolling weekly utilization reaches this percentage, leaving you the remainder.
# It was at 34% when this loop was set up.
LOOP_MAX_SEVEN_DAY_PCT=75

# --- cadence ------------------------------------------------------------------
DECK_EVERY=5                  # rebuild the slide set every N turns
REVIEW_EVERY=4                # quality + security review every N turns (0 disables)

# --- model / effort per turn type ---------------------------------------------
# Effort levels: low | medium | high | xhigh | max.
MODEL=opus
EFFORT_COUNCIL=max
EFFORT_EVALUATE=max
EFFORT_IMPLEMENT=high
EFFORT_MERGE=medium
EFFORT_DECK=medium
EFFORT_REVIEW=high

# --- ultracode per turn type --------------------------------------------------
# Ultracode makes a turn author and run a multi-agent Workflow for every substantive
# task instead of working solo. It buys adversarial breadth and costs a multiple of
# the quota, so it is enabled per turn type rather than globally.
#
#   evaluate  ON  -- judging one idea is exactly where independent, adversarial
#                    verification pays, and it is the loop's weakest link: a bad
#                    accept costs a whole 40-minute implement turn.
#   council   OFF -- the `council` skill already runs four agents over three rounds.
#                    Stacking a workflow on top nests fan-out inside fan-out.
#   implement OFF -- already the longest turn; a workflow would blow its timeout.
#   merge     OFF -- it re-runs a deterministic gate. Breadth adds nothing.
#   deck      OFF -- a rebuild from claims.json, not a research question.
#
# Set every one to 1 for a full ultracode night -- expect the weekly guard above to
# be what stops the loop, well before the wall clock does.
ULTRACODE_COUNCIL=0
ULTRACODE_EVALUATE=1
ULTRACODE_IMPLEMENT=0
ULTRACODE_MERGE=0
ULTRACODE_DECK=0
#   review    ON  -- quality and security are different lenses on the same diff and
#                    a single reviewer serialises them. This is also the one turn
#                    whose whole value is catching what the author missed.
ULTRACODE_REVIEW=1

# --- per-turn timeouts in seconds ---------------------------------------------
TIMEOUT_COUNCIL=2700
TIMEOUT_EVALUATE=1200
TIMEOUT_IMPLEMENT=2400
TIMEOUT_MERGE=1800
TIMEOUT_DECK=1500
TIMEOUT_REVIEW=1800

# --- git ----------------------------------------------------------------------
INTEGRATION_BRANCH=main
REMOTE=origin
PUSH=1                        # 0 = work locally only, never contact origin
